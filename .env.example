DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@localhost:5432/<DB_NAME>
LOG_LEVEL=INFO

# 웹 프런트엔드 주소 (로그인 후 돌아갈 곳)
WEB_BASE_URL=http://localhost:3000
# 세션·OAuth state 서명 키. 충분히 긴 무작위 문자열 (예: openssl rand -hex 32)
SESSION_SECRET=
# 로컬 http 개발에서는 false
IS_SESSION_COOKIE_SECURE=false

# GitHub App (로그인 + 저장소 접근). 값은 App 설정 페이지에서 확인한다
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM 전체. 한 줄로 넣을 때는 줄바꿈을 \n 으로 쓴다
GITHUB_APP_PRIVATE_KEY=
# 웹훅 서명 검증 키. App 설정의 Webhook secret 과 같은 값
GITHUB_WEBHOOK_SECRET=

# 독립 Analysis Worker. 모델 자격증명은 작업 DB와 응답에 저장되지 않는다.
ANALYSIS_PROVIDER=hive-ai
ANALYSIS_MODEL=zai-org/glm-5.3-flash
ANALYSIS_API_KEY=
ANALYSIS_OUTPUT_MODE=json_text
ANALYSIS_EXECUTABLE=opencode
ANALYSIS_SERVER_URL=
ANALYSIS_SERVER_PASSWORD=
ANALYSIS_TIMEOUT_SECONDS=180
ANALYSIS_LEASE_SECONDS=60
# Worker 간 공유하는 영속 경로로 구성한다. 기본 파일은 이 호스트의 실행만 합산한다.
ANALYSIS_BUDGET_LEDGER=/tmp/iris-analysis-budget.json
ANALYSIS_MAX_COST_USD=1

# Build Worker (AWS SDK는 Workload Identity/IAM role 또는 표준 AWS credential chain 사용)
AWS_REGION=ap-northeast-2
CODEBUILD_PROJECT=
ARTIFACT_BUCKET=

# Deploy Worker. 실제 GitOps ApplicationSet 계약과 같아야 한다.
BASE_DOMAIN=
GITOPS_REPOSITORY=2026-softbank-1/iris-gitops-environments
GITOPS_BRANCH=main
GITOPS_APP_ID=
GITOPS_APP_PRIVATE_KEY=
GITOPS_INSTALLATION_ID=
ARGOCD_SERVER_URL=
ARGOCD_TOKEN=
GITOPS_PATH_TEMPLATE=services/{service_id}/{environment}
ARGO_APPLICATION_TEMPLATE=svc-{service_id}

# 실패 로그 Diagnosis Worker. 모델명·요금은 운영자가 명시한다. 자동 대체 없음.
DIAGNOSIS_MODEL=
DIAGNOSIS_API_KEY=
DIAGNOSIS_INPUT_USD_PER_MILLION=
DIAGNOSIS_OUTPUT_USD_PER_MILLION=
DIAGNOSIS_AWS_REGION=ap-northeast-2
DIAGNOSIS_CODEBUILD_PROJECT=
DIAGNOSIS_BUDGET_LEDGER=/tmp/iris-analysis-budget.json
DIAGNOSIS_MAX_COST_USD=1
