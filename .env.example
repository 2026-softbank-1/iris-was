DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@localhost:5432/<DB_NAME>
LOG_LEVEL=INFO

# 웹 프런트엔드 주소 (로그인 후 돌아갈 곳)
WEB_BASE_URL=http://localhost:3000
# Control API 의 공개 주소. CLI 로그인의 verificationUrl 에 쓴다(없으면 요청의 Host). 운영은 https 주소로 지정
# API_BASE_URL=https://api.likelion.uk
# 세션·OAuth state 서명 키. 충분히 긴 무작위 문자열 (예: openssl rand -hex 32)
SESSION_SECRET=
# 로컬 http 개발에서는 false
IS_SESSION_COOKIE_SECURE=false

# GitHub App (로그인 + 저장소 접근). 값은 App 설정 페이지에서 확인한다
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM 전체. 한 줄로 넣을 때는 줄바꿈을 \n 으로 쓴다
GITHUB_APP_PRIVATE_KEY=
# 웹훅 서명 검증 키. App 설정의 Webhook secret 과 같은 값
GITHUB_WEBHOOK_SECRET=

# 서비스 환경변수 암호화 키(Fernet). 없으면 변수 API 는 503.
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VARIABLES_ENCRYPTION_KEY=

# 로그·메트릭 백엔드(management 클러스터 내부) 주소. 없으면 관측 API 는 503
# LOKI_URL=http://loki.observability:3100
# PROMETHEUS_URL=http://monitoring-prometheus.observability:9090

# 서비스 콘솔(Pod 셸). 셋 다 있어야 켜진다(없으면 콘솔 API 는 NOT_CONFIGURED). docs/console-api.md
# openssl genpkey -algorithm ED25519 -out console-ticket.pem  (개인키는 여기, 공개키는 Console Gateway 에)
# CONSOLE_TICKET_PRIVATE_KEY=
# CONSOLE_GATEWAY_HTTP_URL=https://api.likelion.uk
# CONSOLE_GATEWAY_WS_URL=wss://api.likelion.uk

# Console Gateway 전용 (uvicorn app.console_gateway.main:app). DATABASE_URL 은 필요 없다. docs/configuration.md
# CONSOLE_TICKET_PUBLIC_KEY=
# CONSOLE_AWS_CLUSTER_NAME=<EKS_CLUSTER_NAME>
# CONSOLE_AWS_CLUSTER_ENDPOINT=https://<EKS_API_ENDPOINT>
# CONSOLE_AWS_CLUSTER_CA=<BASE64_CA>
# CONSOLE_ALLOWED_ORIGINS=https://app.likelion.uk

# Build Worker 전용 (GitHub App 값은 위와 같은 것을 쓴다)
AWS_REGION=<AWS_REGION>
CODEBUILD_PROJECT=<CODEBUILD_PROJECT>
ARTIFACT_BUCKET=<ARTIFACT_BUCKET>

# Deploy Worker 전용 (AWS_REGION 공용)
GITOPS_REPOSITORY=<ORG>/gitops-environments
GITOPS_APP_ID=<GITOPS_APP_ID>
GITOPS_APP_PRIVATE_KEY=<PEM>
GITOPS_INSTALLATION_ID=<INSTALLATION_ID>
ARGOCD_SERVER_URL=<ARGOCD_SERVER_URL>
ARGOCD_TOKEN=<ARGOCD_PROJECT_ROLE_TOKEN>
# 사용자 환경변수를 앱에 넘길 때만 필요하다. VARIABLES_ENCRYPTION_KEY 는 위 Control API 값과 같다.
# SEALED_SECRETS_CERT 는 workload Sealed Secrets controller 의 공개 인증서(PEM, \n 두 글자 허용).
# 설정하면 사용자 변수 기능이 켜진다. iris-service chart 0.6.0 이상이 배포된 뒤에만 설정한다.
# SEALED_SECRETS_CERT=
# 카나리·블루그린 배포 방식. Control API·Deploy Worker 같은 값. iris-service chart 0.7.0 배포 뒤에 켠다.
# DEPLOYMENT_STRATEGY_ENABLED=false
# 관리형 DB·호스트 별칭·참조 변수(chart 0.9.0 AWS pin 뒤에 켠다). Control API·Deploy Worker 같은 값
# PROJECT_NETWORKING_ENABLED=false

# AI code repair candidate generation (read-only snapshot access; no publication/deployment).
REPAIR_AGENT_URL=
REPAIR_AGENT_API_KEY=
REPAIR_AGENT_TIMEOUT_SECONDS=150
REPAIR_AGENT_DEADLINE_SECONDS=240
REPAIR_AGENT_MAX_COST_USD=1
# Exact trusted hostname(s), comma-separated; must match the agent's allowlist.
REPAIR_AGENT_SOURCE_HOSTS=
